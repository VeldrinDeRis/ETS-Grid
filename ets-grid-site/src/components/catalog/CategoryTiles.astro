---
// Плитки підкатегорій з «від … ₴» (SPEC-002 §3.4 п. 2).
import { formatPrice } from '../../lib/format';
import { productPrice } from '../../lib/filters';
import { routes } from '../../lib/routes';
import type { Category, Product } from '../../lib/schema';

interface Props {
  levelSlug: string;
  categories: Category[];
  products: Product[];
}
const { levelSlug, categories, products } = Astro.props;

function fromPrice(slug: string): string {
  const list = products.filter((p) => p.category === slug);
  if (list.length === 0) return 'Підберемо під ваш обʼєкт';
  const prices = list.map(productPrice).filter((x): x is number => x !== null);
  return prices.length ? `від ${formatPrice(Math.min(...prices))}` : 'Ціна за розрахунком';
}
---
<ul role="list" class="tiles">
  {
    categories.map((c) => (
      <li>
        <a class="tile" href={routes.category(levelSlug, c.slug)}>
          <span class="tile__name">{c.name}</span>
          {c.hint && <span class="tile__hint">{c.hint}</span>}
          <span class="tile__price num">{fromPrice(c.slug)}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--space-s);
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    height: 100%;
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    text-decoration: none;
  }
  .tile:hover .tile__name {
    text-decoration: underline;
  }
  .tile__name {
    font-weight: 700;
  }
  .tile__hint {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
  .tile__price {
    margin-top: auto;
    padding-top: var(--space-2xs);
    font-weight: 600;
  }
</style>
