---
// Порожня видача на сервері (SPEC-002 §4, Q-2 → D-027): текст, 3 найближчі товари, місце для форми.
import LeadForm from '../forms/LeadForm.astro';
import { getProductsBy, getLevelById } from '../../lib/catalog';
import { nearestProducts } from '../../lib/filters';
import ProductCard from './ProductCard.astro';

interface Props {
  levelId: number;
}
const { levelId } = Astro.props;
const level = getLevelById(levelId);
const nearest = nearestProducts(await getProductsBy({ level: level.key }), { level: levelId, exclude: [] });
const subject = levelId === 1 ? 'Таких станцій немає.' : 'Таких товарів немає.';
---
<section class="empty" aria-labelledby="empty-title" data-empty-state>
  <h2 id="empty-title" class="empty__title">{subject} Скиньте фільтр або дайте нам 3 питання — підберемо.</h2>
  <p class="empty__lead">Поки пропонуємо схожі товари цього розділу:</p>
  <div class="empty__list">
    {nearest.map((p) => <ProductCard product={p} variant="compact" />)}
  </div>
  <div class="empty__form">
    <LeadForm kind="level" level={level.key} headingLevel={3} />
  </div>
</section>

<style>
  .empty {
    padding: var(--space-l);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
  }
  .empty__title {
    font-size: var(--step-1);
  }
  .empty__lead {
    color: var(--color-ink-muted);
  }
  .empty__form {
    margin-top: var(--space-l);
  }
  .empty__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-m);
  }
</style>
