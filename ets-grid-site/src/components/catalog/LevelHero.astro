---
// Міні-герой рівня (SPEC-002 §3.4 п. 1). Фото для макета — SPEC-010 §5; без фото — видимий плейсхолдер (D-031).
import type { PhotoKey } from '../../lib/photos';
import Photo from '../ui/Photo.astro';
import Placeholder from '../ui/Placeholder.astro';

interface Props {
  title: string;
  value: string;
  pickerHref: string;
  photo?: PhotoKey;
}
const { title, value, pickerHref, photo } = Astro.props;
---
<div class="level-hero">
  <div class="level-hero__text">
    <h1>{title}</h1>
    <p class="level-hero__value">{value}</p>
    <a class="btn btn--primary level-hero__cta" href={pickerHref}>Підібрати за 3 питання</a>
  </div>
  {
    photo ? (
      <div class="level-hero__photo">
        <Photo photo={photo} sizes="(max-width: 959px) calc(100vw - 2rem), 40vw" priority />
      </div>
    ) : (
      <div class="level-hero__photo level-hero__photo--empty" aria-hidden="true">
        <Placeholder label="[ФОТО]" />
      </div>
    )
  }
</div>

<style>
  .level-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .level-hero__value {
    font-size: var(--step-1);
    color: var(--color-ink-muted);
  }
  .level-hero__cta {
    padding-inline: var(--space-l);
  }
  .level-hero__photo {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }
  .level-hero__photo--empty {
    display: grid;
    place-items: center;
  }
  @media (max-width: 959.98px) {
    .level-hero {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .level-hero__photo {
      aspect-ratio: 16 / 9;
    }
  }
</style>
