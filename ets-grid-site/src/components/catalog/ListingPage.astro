---
// Шаблон лістингу і ЧПУ-сторінки фільтра (SPEC-002 §3.4).
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { FilterPreset } from '../../lib/filters';
import { routes } from '../../lib/routes';
import { itemList, ld, seoTitle } from '../../lib/seo';
import type { Category, Product, StructureLevel } from '../../lib/schema';
import Section from '../ui/Section.astro';
import Catalog from './Catalog.astro';
import PopularPresets from './PopularPresets.astro';

interface Props {
  level: StructureLevel;
  category: Category;
  products: Product[];
  preset?: FilterPreset;
}
const { level, category, products, preset } = Astro.props;
const categoryUrl = routes.category(level.slug, category.slug);
const h1 = preset?.h1 ?? category.name;
const title = preset ? preset.h1 : `${category.name} — ${level.name.toLowerCase()}`;
const metaTitle = preset ? preset.h1 : seoTitle.listing(category.name, level.name);
const description =
  preset?.description ??
  `${level.name}, ${category.name.toLowerCase()}${category.hint ? `: ${category.hint}` : ''}. Ціни з монтажем, доставка по Україні.`;
const crumbs = [
  { label: level.name, href: routes.level(level.slug) },
  ...(preset ? [{ label: category.name, href: categoryUrl }, { label: preset.h1 }] : [{ label: category.name }]),
];
---
<BaseLayout title={title} metaTitle={metaTitle} description={description} crumbs={crumbs} jsonLd={ld(itemList(Astro.site!, products))}>
  <Fragment slot="top">
    <h1>{h1}</h1>
    {category.hint && !preset && <p class="listing__hint">{category.hint}</p>}
    <PopularPresets level={level.key} levelSlug={level.slug} category={category.slug} current={preset?.slug} />
    <p class="listing__picker">
      <a href={level.picker_href}>Не знаєте, що обрати? Підбір за 3 питання</a>
    </p>
  </Fragment>
  <Section seam="dawn">
    <h2 class="listing__results-title">Товари</h2>
    <Catalog
      products={products}
      levelId={level.id}
      preset={preset ? { filters: preset.filters, categoryUrl } : undefined}
    />
  </Section>
</BaseLayout>

<style>
  .listing__hint {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .listing__picker {
    margin: 0;
  }
  .listing__picker a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
  .listing__results-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
