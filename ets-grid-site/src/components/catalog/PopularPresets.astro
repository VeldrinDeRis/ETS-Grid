---
// «Популярні добірки»: посилання на ЧПУ-сторінки категорії (SPEC-002 §4). Видно з JS і без.
import filtersJson from '../../data/filters.json';
import type { FiltersFile } from '../../lib/filters';
import { routes } from '../../lib/routes';
import type { LevelKey } from '../../lib/schema';

interface Props {
  level: LevelKey;
  levelSlug: string;
  category: string;
  current?: string;
}
const { level, levelSlug, category, current } = Astro.props;
const presets = (filtersJson as unknown as FiltersFile).presets.filter((p) => p.level === level && p.category === category);
---
{
  presets.length > 0 && (
    <nav class="presets" aria-label="Популярні добірки">
      <span class="presets__label">Популярні добірки:</span>
      <ul role="list" class="presets__list">
        {presets.map((p) => (
          <li>
            <a href={routes.preset(levelSlug, category, p.slug)} aria-current={p.slug === current ? 'page' : undefined}>
              {p.h1}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--step--1);
  }
  .presets__label {
    color: var(--color-ink-muted);
  }
  .presets__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
  }
  /* Добірки — пігулки з рамкою line (у нічному порозі — night-line, SPEC-002 §3.11). */
  .presets a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-s);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .presets a:hover {
    border-color: var(--color-ink-muted);
  }
  .presets a[aria-current='page'] {
    border-color: var(--color-ink);
    font-weight: 700;
  }
  /* Телефон: пігулки в один ряд із прокруткою, поріг не росте. */
  @media (max-width: 639.98px) {
    .presets__list {
      flex-wrap: nowrap;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>
