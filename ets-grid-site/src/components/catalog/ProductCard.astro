---
// Картка товару в лістингу (SPEC-002 §3.5, §3.10 міні-галерея — D-065). Використовують також SPEC-003 і SPEC-006.
import { getLevelById } from '../../lib/catalog';
import { cardBadge, keyChars } from '../../lib/filters';
import { productImage } from '../../lib/images';
import { routes } from '../../lib/routes';
import type { Product } from '../../lib/schema';
import { LEVEL_ICON } from '../../lib/level-icons';
import Icon from '../layout/Icon.astro';
import { ILLUSTRATION_LABEL, PRODUCT_ILLUSTRATION, productFrames } from '../../lib/photos';
import CardGallery from '../../islands/react/CardGallery';
import Photo from '../ui/Photo.astro';
import Price from '../ui/Price.astro';

interface Props {
  product: Product;
  variant?: 'listing' | 'compact';
  headingLevel?: 2 | 3 | 4;
  /** Міні-галерея з 5 ілюстративних кадрів (§3.10); у хітах головної й compact — лише перший кадр. */
  gallery?: boolean;
  /** Перший ряд лістингу: перший кадр eager + fetchpriority="high" (SPEC-002 §3.10.1, D-069). */
  priority?: boolean;
}
const { product, variant = 'listing', headingLevel = 3, gallery = variant === 'listing', priority = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const image = productImage(product);
const badge = cardBadge(product);
const chars = variant === 'listing' ? keyChars(product) : [];
const level = getLevelById(product.level);
const inStock = product.stock === 'in_stock';
// Кадри галереї — лише без фото замовника; без галереї показуємо перший кадр набору (або ілюстрацію).
const frames = image ? [] : productFrames(product.slug);
const illustration = image ? undefined : gallery ? undefined : (PRODUCT_ILLUSTRATION[product.slug] ?? frames[0]);
const showGallery = !image && gallery && frames.length > 1;
---
<article class:list={["product-card", `product-card--${variant}`]} data-product-card data-layout data-slug={product.slug}>
  <div class:list={['product-card__photo', showGallery && 'product-card__photo--gallery']}>
    {
      image ? (
        <img src={image.src} alt={image.alt} width="400" height="400" loading="lazy" decoding="async" />
      ) : showGallery ? (
        <CardGallery client:intent count={frames.length} label={product.name}>
          {frames.map((key, i) => (
            <div slot={`shot${i}`} class="product-card__frame">
              <Photo photo={key} sizes="(max-width: 639px) calc(100vw - 3rem), 18rem" class="product-card__illustration" priority={priority && i === 0} />
              <span class="photo-note">{ILLUSTRATION_LABEL}</span>
            </div>
          ))}
        </CardGallery>
      ) : illustration ? (
        <>
          <Photo photo={illustration} sizes="(max-width: 639px) calc(100vw - 3rem), 18rem" class="product-card__illustration" priority={priority} />
          <span class="photo-note">{ILLUSTRATION_LABEL}</span>
        </>
      ) : (
        <span class="product-card__photo-label" aria-hidden="true">
          <Icon name={LEVEL_ICON[level.key]} size={36} />
          <span>Фото надасть замовник</span>
        </span>
      )
    }
    {badge && <span class="product-card__badge">{badge}</span>}
  </div>

  <div class="product-card__body">
    <Heading class="product-card__title">
      <a href={routes.product(product.slug)}>{product.name}</a>
    </Heading>

    {
      chars.length > 0 && (
        <ul role="list" class="product-card__chars">
          {chars.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      )
    }

    <Price product={product} />

    <p class:list={['product-card__stock', inStock ? 'is-in-stock' : 'is-preorder']}>
      <span class="product-card__led" aria-hidden="true"></span>
      {inStock ? 'В наявності' : `Під замовлення · ${product.delivery_days} дн.`}
    </p>

    <div class="product-card__actions">
      {
        product.sale_mode === 'cart' ? (
          <button type="button" class="product-card__cta js-only" data-add-to-cart={product.slug}>
            До кошика
          </button>
        ) : (
          <a class="product-card__cta product-card__cta--quote" href={routes.quoteFor(product.slug)}>
            Розрахувати<span class="visually-hidden">: {product.name}</span>
          </a>
        )
      }
      {
        variant === 'listing' && (
          <button type="button" class="product-card__compare js-only" data-compare={product.slug} aria-pressed="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <path d="M8 4v16M16 4v16M4 8h8M12 16h8" />
            </svg>
            <span class="visually-hidden">Порівняти: {product.name}</span>
          </button>
        )
      }
    </div>
    <p class="product-card__status visually-hidden" role="status" data-card-status></p>
  </div>
</article>

<script>
  import '../../scripts/card-actions';
</script>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    overflow: hidden;
  }
  /* Плита товару вкладена в білу картку — силует картки читається й на денному тлі (Product Plate). */
  .product-card__photo {
    position: relative;
    display: grid;
    place-items: center;
    margin: var(--space-xs) var(--space-xs) 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--day-bg);
    color: var(--day-ink-muted);
  }
  .product-card--compact .product-card__photo {
    aspect-ratio: 4 / 3;
  }
  .product-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Міні-галерея (§3.10): кадр 1:1; острів малює розмітку сам — :global. Бейдж лишається поверх (absolute у .product-card__photo). */
  .product-card__photo--gallery {
    display: block;
  }
  .product-card__photo--gallery :global(.product-card__frame) {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .product-card__photo--gallery :global(.product-card__frame img) {
    object-fit: cover;
  }
  .product-card__photo--gallery :global(.pgal__shot) {
    width: 100%;
    flex: none;
  }
  .product-card__photo--gallery :global(.pgal__shot > astro-slot),
  .product-card__photo--gallery :global(.pgal__shot > div) {
    display: block;
  }
  /* Острів — квадрат з обрізанням завжди: без JS (атрибут ssr лишається) і до гідратації кадри не стирчать. */
  .product-card__photo--gallery :global(astro-island) {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .product-card__photo--gallery :global(.pgal__nav) {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3xs);
    padding: var(--space-3xs) var(--space-2xs);
    background: linear-gradient(transparent, rgb(13 20 36 / 0.55));
  }
  .product-card__photo--gallery :global(.pgal__arrow) {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: rgb(244 246 248 / 0.9);
    color: var(--day-ink);
    cursor: pointer;
    transition: opacity var(--dur-fast);
  }
  .product-card__photo--gallery :global(.pgal__arrow:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  .product-card__photo--gallery :global(.pgal__dots) {
    display: flex;
    gap: 0;
    padding: 0 var(--space-2xs);
  }
  /* Точка активного кадру — янтарна лампа (The Lit Chip Rule), решта — скло. */
  /* Кнопка 24×24 (WCAG 2.5.8, D-069), видимий кружок 6 px — у ::before. */
  .product-card__photo--gallery :global(.pgal__dot) {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .product-card__photo--gallery :global(.pgal__dot::before) {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: rgb(244 246 248 / 0.5);
    transition:
      background-color var(--dur-fast),
      transform var(--dur) var(--ease-out);
  }
  .product-card__photo--gallery :global(.pgal__dot[aria-selected='true']::before) {
    background: var(--color-accent);
    transform: scale(1.4);
  }
  /* Мітка — над навігацією, щоб не перекривалась стрілками. */
  .product-card__photo--gallery :global(.product-card__frame .photo-note) {
    bottom: calc(2rem + var(--space-xs));
  }
  /* Порожня рамка фото (D-031): значок рівня й підпис звичайним регістром. */
  .product-card__photo-label {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    padding-inline: var(--space-s);
    color: var(--day-ink-muted);
    font-size: var(--step--1);
    text-align: center;
  }
  .product-card__badge {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    background: var(--day-surface);
    color: var(--day-ink);
    font-size: var(--step--1);
    font-weight: 600;
    box-shadow: var(--shadow-1);
  }
  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m);
  }
  .product-card__title {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .product-card__title a {
    text-decoration: none;
  }
  .product-card__title a:hover {
    text-decoration: underline;
  }
  .product-card__chars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }
  .product-card__chars li {
    padding: 0.1em 0.55em;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-s);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
  .product-card__stock {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--step--1);
  }
  .product-card__led {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: currentColor;
  }
  .is-in-stock {
    color: var(--color-status-ok);
  }
  .is-preorder {
    color: var(--color-status-wait);
  }
  .product-card__actions {
    display: flex;
    gap: var(--space-2xs);
    margin-top: auto;
    padding-top: var(--space-2xs);
  }
  .product-card__cta {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: 0 var(--space-s);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .product-card__cta:hover {
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  .product-card__compare {
    display: grid;
    place-items: center;
    width: var(--tap);
    min-height: var(--tap);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .product-card__compare[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
