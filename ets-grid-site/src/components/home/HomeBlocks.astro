---
// Блоки 6, 7, 8, 10, 11 головної (SPEC-006 §4.2). Один компонент — частини за `part`.
import { home } from '../../lib/home';
import { ILLUSTRATION_LABEL, type PhotoKey } from '../../lib/photos';
import { routes } from '../../lib/routes';
import LeadForm from '../forms/LeadForm.astro';
import Picker from '../pickers/Picker.astro';
import Photo from '../ui/Photo.astro';
import Placeholder from '../ui/Placeholder.astro';

interface Props {
  part: 'carport' | 'steps' | 'faq' | 'cases' | 'financing' | 'final';
}
const { part } = Astro.props;
// Блок 9 до реальних кейсів (D-058): фото прототипу з міткою «Ілюстративне фото», підписи — плейсхолдери.
const CASE_SAMPLES: { photo: PhotoKey; title: string; meta: string }[] = [
  { photo: 'carport-below', title: '[Обʼєкт: паркінг із навісом]', meta: '[N] місць · [N] kWp' },
  { photo: 'roof-solar', title: '[Обʼєкт: дім із СЕС і батареєю]', meta: '[N] kWp · [N] кВт·год' },
  { photo: 'bess-container', title: '[Обʼєкт: накопичувач для бізнесу]', meta: '[N] кВт·год · [N] кВт' },
];
---
{
  part === 'carport' && (
    <div class="carport">
      <h2>Solar Carport</h2>
      <div class="carport__grid">
        <aside class="manifesto" data-manifesto>
          <p class="manifesto__big" aria-hidden="true">4 в 1</p>
          <p class="manifesto__text">Навіс. Генерація. Зарядка. Накопичення. Одна конструкція над вашим паркінгом.</p>
        </aside>
        <div class="carport__photo">
          <Photo photo="carport-charging" sizes="(max-width: 959px) calc(100vw - 2rem), 45vw" />
        </div>
      </div>
      <div class="carport__config">
        <Picker kind="carport" mode="mini" />
      </div>
      <p>
        <a class="carport__more" href={routes.level('solar-carport')}>Усе про Solar Carport</a>
      </p>
    </div>
  )
}
{
  part === 'steps' && (
    <div class="steps">
      <h2>Як ми працюємо</h2>
      <ol class="steps__list">
        {home.steps.map((s) => (
          <li>
            <strong>{s.title}</strong>
            <Placeholder label={s.term} />
          </li>
        ))}
      </ol>
    </div>
  )
}
{
  part === 'faq' && (
    <div class="faq">
      <h2>Незручні питання. Прямі відповіді</h2>
      {home.faq.map((item) => (
        <details class="faq__item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  )
}
{
  part === 'cases' && (
    <div class="cases">
      <h2>Обʼєкти</h2>
      <p class="cases-plate">Тут будуть реальні обʼєкти ETS GRID</p>
      {/* Індикативні картки (D-058): фото прототипу з міткою, підписи — плейсхолдери; реальні кейси — від замовника. */}
      <ul role="list" class="cases__list">
        {CASE_SAMPLES.map((c) => (
          <li class="case">
            <div class="case__photo">
              <Photo photo={c.photo} sizes="(max-width: 639px) calc(100vw - 2rem), (max-width: 959px) 50vw, 24rem" />
              <span class="photo-note">{ILLUSTRATION_LABEL}</span>
            </div>
            <p class="case__title">
              <Placeholder label={c.title} />
            </p>
            <p class="case__meta">
              <Placeholder label="[місто]" /> · <Placeholder label={c.meta} />
            </p>
          </li>
        ))}
      </ul>
      <p>
        <a class="carport__more" href={routes.cases}>Сторінка обʼєктів</a>
      </p>
    </div>
  )
}
{
  part === 'financing' && (
    <div class="financing">
      <h2>{home.financing.title}</h2>
      <ul role="list" class="financing__list">
        {home.financing.items.map((item) => (
          <li>
            {item.split(/(\[[^\]]+\])/).map((chunk) => (/^\[[^\]]+\]$/.test(chunk) ? <Placeholder label={chunk} /> : chunk))}
          </li>
        ))}
      </ul>
      <p class="financing__checked">
        {home.financing.checked.split(/(\[[^\]]+\])/).map((chunk) => (/^\[[^\]]+\]$/.test(chunk) ? <Placeholder label={chunk} /> : chunk))}
      </p>
      <a class="financing__cta" href={routes.financing}>
        {home.financing.cta}
      </a>
    </div>
  )
}
{
  part === 'final' && (
    <div class="final">
      <LeadForm kind="final" title={home.final_form.title} />
    </div>
  )
}

<style>
  .carport__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }
  .manifesto {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-m);
    padding: var(--space-l);
    border-radius: var(--radius-l);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .manifesto__big {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 6vw, 8rem);
    font-weight: 800;
    line-height: 0.9;
  }
  .manifesto__text {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 600;
  }
  .carport__photo {
    min-height: 14rem;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }
  .carport__more,
  .financing__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
  /* Кроки — послідовність на лінії мнемосхеми: номер у лампі, лінія до наступного кроку. */
  .steps__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps__list li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
    counter-increment: step;
  }
  .steps__list li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .steps__list li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.125rem;
    left: 2.25rem;
    right: calc(-1 * var(--space-m));
    height: 2px;
    background: var(--color-line);
  }
  @media (max-width: 959.98px) {
    .steps__list li:not(:last-child)::after {
      display: none;
    }
  }
  .faq {
    max-width: 52rem;
  }
  .faq__item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-weight: 600;
    cursor: pointer;
  }
  .financing__list {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step-1);
  }
  .financing__checked {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
  .cases-plate {
    max-width: none;
    padding: var(--space-s) var(--space-m);
    border: 1px dashed var(--color-placeholder);
    border-radius: var(--radius-m);
    color: var(--color-placeholder);
    text-align: center;
  }
  .cases__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
    margin: var(--space-m) 0 var(--space-s);
    padding: 0;
    list-style: none;
  }
  .case__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }
  .case__title {
    margin: var(--space-xs) 0 var(--space-3xs);
    font-weight: 700;
  }
  .case__meta {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
  @media (max-width: 959.98px) {
    .cases__list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 959.98px) {
    .carport__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
