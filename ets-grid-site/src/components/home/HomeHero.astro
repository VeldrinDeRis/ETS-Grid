---
// Блок 1 — продаючий перший екран (SPEC-006 §4.2, ТЗ §6.1).
// Усі варіанти тексту — в HTML як дані; src/scripts/home.ts підміняє їх за ?hero=.
import { getLevels, getProduct, getProductsBy, structure } from '../../lib/catalog';
import { activeVariant, home, levelFromPrice } from '../../lib/home';
import { routes } from '../../lib/routes';
import { isPlaceholder } from '../../lib/schema';
import Container from '../ui/Container.astro';
import Placeholder from '../ui/Placeholder.astro';
import { LEVEL_ICON } from '../../lib/level-icons';
import Icon from '../layout/Icon.astro';
import Photo from '../ui/Photo.astro';
import Price from '../ui/Price.astro';

const variant = activeVariant();
const anchors = [...new Set(home.hero.variants.map((v) => v.anchor_product))];
const anchorProducts = await Promise.all(anchors.map(async (slug) => ({ slug, product: (await getProduct(slug))! })));
const anchorLabel = (slug: string) => home.hero.variants.find((v) => v.anchor_product === slug)!.anchor_label;
const variantsFor = (slug: string) => home.hero.variants.filter((v) => v.anchor_product === slug).map((v) => v.id).join(' ');

const levels = await Promise.all(
  getLevels().map(async (level) => ({ level, from: levelFromPrice(await getProductsBy({ level: level.key })) })),
);
const { phone, telegram, viber } = structure.contacts;
const variantsJson = JSON.stringify(Object.fromEntries(home.hero.variants.map((v) => [v.id, v])));
---
<!-- Акт I «Ніч» (SPEC-006 §4.9, D-054): фото — тло на всю ширину, ніч — тінню зліва; лампа-курсор — src/scripts/home.ts. -->
<section class="hero" data-surface="night" aria-labelledby="hero-title" data-home-block="hero">
  <div class="hero__photo">
    <Photo photo="hero-dc-night" sizes="100vw" priority />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__lamp" aria-hidden="true" data-hero-lamp></div>
  <Container class="hero__inner">
    <div class="hero__text">
      <p class="hero__overline" data-hero-field="overline">{variant.overline}</p>
      <h1 id="hero-title" class="hero__title" data-hero-field="h1">{variant.h1}</h1>
      <p class="hero__subtitle" data-hero-field="subtitle">{variant.subtitle}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary btn--l hero__cta hero__cta--primary" href="#potuzhnist" data-hero-cta="primary" data-hero-field="primary_cta">{variant.primary_cta}</a>
        <a class="btn btn--secondary btn--l hero__cta hero__cta--secondary" href={routes.quote} data-hero-cta="secondary" data-hero-field="secondary_cta">{variant.secondary_cta}</a>
      </div>
      {
        anchorProducts.map(({ slug, product }) => (
          <div class="hero__anchor" data-anchor-for={variantsFor(slug)} hidden={!variantsFor(slug).split(' ').includes(variant.id)}>
            <p class="hero__anchor-label">{anchorLabel(slug)}</p>
            <Price product={product} />
          </div>
        ))
      }
    </div>
    <ul role="list" class="hero__tiles" aria-label="Рівні каталогу">
      {
        levels.map(({ level, from }) => (
          <li>
            <a class="hero__tile" href={routes.level(level.slug)} data-level-tile={level.key}>
              <Icon name={LEVEL_ICON[level.key]} size={28} />
              <span class="hero__tile-name">{level.name}</span>
              <span class="hero__tile-price num">{from}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hero__trust">
      <ul role="list" class="hero__trust-list" aria-label="Чому ETS GRID">
        {
          home.trust.map((t) => (
            <li>
              <Placeholder label={t} />
            </li>
          ))
        }
      </ul>
      <p class="hero__contact">
        <span class="hero__contact-label">Звʼязатися:</span>
        {[phone, telegram, viber].map((c) => (isPlaceholder(c) ? <Placeholder label={c} /> : <span>{c}</span>))}
      </p>
    </div>
  </Container>
  <script type="application/json" id="hero-variants" set:html={variantsJson} />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    overflow: hidden;
    /* Перший екран 1440×900 цілком (ТЗ §6.1): шапка на desktop — рядок --header-h плюс рядок рівнів 3rem. */
    min-height: calc(100svh - var(--header-h) - 3rem);
    --lx: 70%;
    --ly: 40%;
  }
  /* Фото — тло всього блоку (ТЗ: LCP — статичне фото, fetchpriority=high у Photo). */
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -3;
  }
  .hero__photo :global(img) {
    object-position: 72% 50%;
  }
  /* Ніч: зліва щільна під текст, праворуч фото видно; знизу темніє під плитки. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgb(13 20 36 / 0.96) 0 34%, rgb(13 20 36 / 0.78) 52%, rgb(13 20 36 / 0.35) 76%, rgb(13 20 36 / 0.55) 100%),
      linear-gradient(180deg, rgb(13 20 36 / 0.35), transparent 30%, transparent 55%, rgb(13 20 36 / 0.92) 100%);
  }
  /* Лампа-курсор: тепле світло за вказівником проявляє фото (home.ts ставить --lx/--ly, opacity). */
  .hero__lamp {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    background: radial-gradient(36rem circle at var(--lx) var(--ly), rgb(255 181 71 / 0.42), rgb(255 181 71 / 0.14) 36%, transparent 62%);
  }
  .hero :global(.hero__inner) {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: var(--space-m);
    padding-block: clamp(1.25rem, 3vh, 2rem) var(--space-m);
  }
  .hero__text {
    max-width: 40rem;
  }
  .hero__overline {
    margin-bottom: var(--space-xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }
  .hero__title {
    font-size: calc(var(--step-5) * var(--display-scale));
    line-height: 1.05;
    margin-bottom: var(--space-s);
    max-width: 19ch;
  }
  /* SPEC-006 §4.8: до splitText H1 приглушений (не 0 — лишається кандидатом LCP);
     якщо home.ts не завантажився, через 1,2 с H1 сам повертається до opacity 1. */
  :global(html[data-motion='on']) .hero__title:not([data-lit]) {
    opacity: 0.3;
    animation: hero-title-fallback 0s linear 1.2s forwards;
  }
  @keyframes hero-title-fallback {
    to {
      opacity: 1;
    }
  }
  .hero__subtitle {
    font-size: var(--step-0);
    color: var(--color-ink-muted);
    max-width: 36rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block: var(--space-m) var(--space-s);
  }
  .hero__anchor {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
  }
  .hero__anchor[hidden] {
    display: none;
  }
  .hero__anchor-label {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .hero__tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xs);
  }
  /* Плитка-лампа: скло на ночі, вогник праворуч угорі (::after — щоб акцентна лише CTA, AC-17). */
  .hero__tile {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-xs);
    align-items: center;
    height: 100%;
    min-height: 5.25rem;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background: rgb(13 20 36 / 0.55);
    backdrop-filter: blur(10px);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .hero__tile::after {
    content: '';
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.3;
    transition:
      opacity var(--dur),
      box-shadow var(--dur);
  }
  .hero__tile :global(.icon) {
    grid-row: 1 / 3;
    color: var(--color-ink);
  }
  .hero__tile:hover,
  .hero__tile:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-line));
    background: rgb(22 32 58 / 0.75);
    transform: translateY(-2px);
  }
  .hero__tile:hover::after,
  .hero__tile:focus-visible::after {
    opacity: 1;
    box-shadow: 0 0 0 5px rgb(255 181 71 / 0.18);
  }
  .hero__tile-name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .hero__tile-price {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
  /* Довіра і контакт — одним рядком під плитками (макет, D-054). */
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    padding-top: var(--space-xs);
    border-top: 1px solid rgb(42 54 80 / 0.7);
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
  .hero__trust-list,
  .hero__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
  }
  .hero__contact-label {
    color: var(--color-ink-muted);
  }

  @media (max-width: 959.98px) {
    .hero {
      min-height: auto;
    }
    .hero :global(.hero__inner) {
      padding-top: var(--space-l);
    }
    .hero__photo :global(img) {
      object-position: 60% 50%;
    }
    .hero__shade {
      background: linear-gradient(180deg, rgb(13 20 36 / 0.97) 0 42%, rgb(13 20 36 / 0.6) 62%, rgb(13 20 36 / 0.96) 100%);
    }
    .hero__lamp {
      display: none;
    }
    .hero__title {
      font-size: calc(var(--step-4) * var(--display-scale));
      max-width: none;
    }
    .hero__subtitle {
      font-size: var(--step-0);
    }
    .hero__ctas {
      margin-block: var(--space-s);
    }
    .hero__cta {
      flex: 1 1 100%;
    }
    /* Плитки — горизонтальна стрічка. */
    .hero__tiles {
      display: flex;
      overflow-x: auto;
      gap: var(--space-2xs);
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) var(--space-3xs);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .hero__tiles li {
      flex: 0 0 72%;
      scroll-snap-align: start;
    }
  }
</style>
