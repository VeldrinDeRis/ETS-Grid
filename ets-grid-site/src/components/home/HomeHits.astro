---
// Блок 4 — хіти каталогу як вітрина (SPEC-006 §4.10 акт IV, D-057): картки ProductCard у Carousel Motion+
// (острів src/islands/react/HitsCarousel.tsx), кнопки-фільтри за рівнем усередині острова.
// Картки — серверний HTML через іменовані слоти, тож без JS вони теж у документі.
import HitsCarousel from '../../islands/react/HitsCarousel';
import { getLevels, getProduct } from '../../lib/catalog';
import { home } from '../../lib/home';
import type { Product } from '../../lib/schema';
import ProductCard from '../catalog/ProductCard.astro';

const hits = (await Promise.all(home.hits.map((slug) => getProduct(slug)))).filter((p): p is Product => Boolean(p));
const levels = getLevels()
  .filter((l) => hits.some((p) => p.level === l.id))
  .map((l) => ({ id: l.id, name: l.name }));
---
<div class="hits">
  <h2 id="hits-title">Хіти каталогу</h2>
  <HitsCarousel client:visible levels={levels} hits={hits.map((p) => ({ slug: p.slug, level: p.level }))}>
    {hits.map((p, i) => <div slot={`card${i}`} class="hits__card"><ProductCard product={p} gallery={false} /></div>)}
  </HitsCarousel>
</div>

<style is:global>
  /* Острів рендерить розмітку сам — стилі глобальні, обмежені .hits. */
  .hits__filters {
    display: flex;
    gap: var(--space-2xs);
    margin-bottom: var(--space-m);
    overflow-x: auto;
    padding-bottom: var(--space-3xs);
  }
  /* Рев. 6.1 (D-064): The Lit Chip Rule — вибір показує вогник, а не заливка; зразок — .cf-option каталогу. */
  .hits__filters button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    flex: none;
    min-height: var(--tap);
    padding: 0 var(--space-m);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font-weight: 600;
    cursor: pointer;
  }
  /* Вогник: 6 px акценту, у спокої тліє на 0,3; вибраний — горить з ореолом. Лише opacity і box-shadow;
     за prefers-reduced-motion перехід миттєвий (глобальне правило base.css). */
  .hits__filters button::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.3;
    /* Ореол сталий, загоряння — лише opacity (D-072): у спокої тліє разом із вогником. */
    box-shadow: 0 0 8px var(--color-accent);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .hits__filters button[aria-pressed='true'] {
    border-color: var(--color-ink);
    font-weight: 700;
  }
  .hits__filters button[aria-pressed='true']::before {
    opacity: 1;
  }
  .hits__track {
    position: relative;
    padding-block: var(--space-2xs);
  }
  .hits__item {
    width: clamp(15rem, calc((100% - 3rem) / 4), 18.5rem);
    flex: none;
  }
  .hits__item > astro-slot,
  .hits__card {
    display: block;
    height: 100%;
  }
  /* До гідратації острів ще не керує розміткою: картки-слоти в ряд, зайве — за краєм. */
  .hits astro-island:not([ssr]) {
    display: flex;
    gap: var(--space-s);
    overflow: hidden;
  }
  .hits astro-island:not([ssr]) > .hits__card {
    flex: 0 0 clamp(15rem, calc((100% - 3rem) / 4), 18.5rem);
  }
  .hits__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
  .hits__arrow {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--dur-fast),
      opacity var(--dur-fast);
  }
  .hits__arrow:hover:not(:disabled) {
    background: var(--color-bg);
  }
  .hits__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .hits__dots {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  /* Точка-лампа сторінки: активна — янтар, решта — лінія. */
  /* Кнопка 24×24 (WCAG 2.5.8, D-069), видимий кружок — у ::before. */
  .hits__dot {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hits__dot::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-line);
    transition:
      background-color var(--dur-fast),
      transform var(--dur) var(--ease-out);
  }
  .hits__dot[aria-selected='true']::before {
    background: var(--color-accent);
    transform: scale(1.3);
  }
  @media (max-width: 959.98px) {
    .hits__item,
    .hits astro-island:not([ssr]) > .hits__card {
      width: 78vw;
      max-width: 20rem;
      flex-basis: 78vw;
    }
  }
</style>
