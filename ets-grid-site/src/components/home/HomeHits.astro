---
// Блок 4 — хіти каталогу: картки ProductCard, кнопки-фільтри за рівнем (SPEC-006 §4.2, ревізія 1).
import { getLevels, getProduct } from '../../lib/catalog';
import { home } from '../../lib/home';
import type { Product } from '../../lib/schema';
import ProductCard from '../catalog/ProductCard.astro';

const hits = (await Promise.all(home.hits.map((slug) => getProduct(slug)))).filter((p): p is Product => Boolean(p));
const levels = getLevels().filter((l) => hits.some((p) => p.level === l.id));
---
<div class="hits" data-hits>
  <h2 id="hits-title">Хіти каталогу</h2>
  <div class="hits__filters js-only" role="group" aria-labelledby="hits-title">
    <button type="button" aria-pressed="true" data-hits-filter="all">Усі</button>
    {
      levels.map((l) => (
        <button type="button" aria-pressed="false" data-hits-filter={String(l.id)}>
          {l.name}
        </button>
      ))
    }
  </div>
  <div class="hits__grid">
    {
      hits.map((p) => (
        <div class="hits__item" data-hits-level={String(p.level)}>
          <ProductCard product={p} />
        </div>
      ))
    }
  </div>
</div>

<style>
  .hits__filters {
    display: flex;
    gap: var(--space-2xs);
    margin-bottom: var(--space-m);
    overflow-x: auto;
    padding-bottom: var(--space-3xs);
  }
  .hits__filters button {
    flex: none;
    min-height: var(--tap);
    padding: 0 var(--space-m);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font-weight: 600;
    cursor: pointer;
  }
  .hits__filters button[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .hits__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-m);
  }
  .hits__item[hidden] {
    display: none;
  }
  .hits__item > :global(*) {
    height: 100%;
  }
</style>
