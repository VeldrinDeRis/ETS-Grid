---
// Хлібні крихти (SPEC-001 §3.4): перша «Головна», остання — поточна сторінка без посилання.
import Container from '../ui/Container.astro';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const last = items.length - 1;
---
<nav class="crumbs" aria-label="Хлібні крихти">
  <Container>
    <ol role="list" class="crumbs__list">
      {
        items.map((item, i) => (
          <li class="crumbs__item">
            {i < last && item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span aria-current={i === last ? 'page' : undefined}>{item.label}</span>
            )}
          </li>
        ))
      }
    </ol>
  </Container>
</nav>

<style>
  .crumbs {
    padding-block: var(--space-s) 0;
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
  .crumbs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) 0;
  }
  .crumbs__item {
    display: inline-flex;
    align-items: center;
  }
  .crumbs__item + .crumbs__item::before {
    content: '›';
    padding-inline: var(--space-2xs);
    color: var(--color-ink-muted);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .crumbs [aria-current='page'] {
    color: var(--color-ink);
  }
</style>
