---
// Лінійні іконки ETS GRID (SPEC-010 §4, ТЗ §8.4): один набір, обводка 1,75, сітка 24, закруглені кінці.
// Декоративні за замовчуванням (aria-hidden); з label — role="img" і підпис.
interface Props {
  name: IconName;
  size?: number;
  /** Підпис для іконки, що несе сенс сама по собі (без тексту поруч). */
  label?: string;
}

/** Мале коло як контур — для контактів розʼємів. */
const dot = (x: number, y: number, r = 1.2) => `M${x - r} ${y}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;
const ring = (x: number, y: number, r: number) => dot(x, y, r);

const paths = {
  // службові
  'chevron-down': 'M6 9l6 6 6-6',
  cart: 'M3 4h2l2.4 10.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6.2M9 20h.01M17 20h.01',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-5-5',
  phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
  compare: 'M8 4v16M16 4v16M4 8h8M12 16h8',
  // рівні
  station: 'M6 21V6a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v15M4 21h14M9 8h4M11 12l-1.5 2.5h3L11 17M16 9h2a2 2 0 0 1 2 2v5a1.5 1.5 0 0 0 3 0',
  sun: `${ring(12, 12, 4)}M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8`,
  battery: 'M8 5h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM10 2.5h4M9.5 16.5h5M9.5 13h5M9.5 9.5h5',
  carport: 'M3 9l9-4 9 4M5 8.1V20M19 8.1V20M8 17h8M8.5 17v-2.2a1.5 1.5 0 0 1 1.5-1.5h4a1.5 1.5 0 0 1 1.5 1.5V17',
  // характеристики
  power: 'M13 2 5 13.5h6l-1 8.5 8-11.5h-6z',
  phases: 'M3 7h18M3 12h18M3 17h18M7 5v4M12 10v4M17 15v4',
  ip: 'M12 3s6 6.4 6 10.5a6 6 0 0 1-12 0C6 9.4 12 3 12 3zM9.5 14a2.5 2.5 0 0 0 2.5 2.5',
  warranty: 'M12 3 5 6v5.5c0 4.4 3 8 7 9.5 4-1.5 7-5.1 7-9.5V6zM9 12l2 2 4-4',
  control: 'M8 2.5h8a1.5 1.5 0 0 1 1.5 1.5v16a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 20V4A1.5 1.5 0 0 1 8 2.5zM11 18.5h2M9.5 9.5a3.5 3.5 0 0 1 5 0M10.8 11.6a1.6 1.6 0 0 1 2.4 0',
  cable: 'M7 3v4M11 3v4M5.5 7h7v3a3.5 3.5 0 0 1-7 0zM9 13.5V17a4 4 0 0 0 8 0v-4a3 3 0 0 1 3-3h1',
  // послуги
  delivery: 'M2 6h11v10H2zM13 9h4.5l3.5 3.5V16h-8M6.5 19a1.8 1.8 0 1 0 0-.01M17 19a1.8 1.8 0 1 0 0-.01',
  install: 'M14.5 6.5a4 4 0 0 0 5 5L21 13l-8 8-3-3 8-8M14.5 6.5 13 5 5 13l3 3M3 21l3-3',
  project: 'M4 3h11l5 5v13H4zM15 3v5h5M8 13h8M8 17h5',
  service: 'M4 13v-1a8 8 0 0 1 16 0v1M4 13h3v5H5a1 1 0 0 1-1-1zM20 13h-3v5h2a1 1 0 0 0 1-1zM17 18v.5a2.5 2.5 0 0 1-2.5 2.5H12',
  // розʼєми — власні схеми контактів у тій самій манері
  type2: `M5.5 8.5A8 8 0 1 0 18.5 8.5L16.5 4.5H7.5Z${dot(9, 9)}${dot(15, 9)}${dot(12, 8)}${dot(8, 13)}${dot(16, 13)}${dot(10, 16.5)}${dot(14, 16.5)}`,
  ccs2: `M7 3.5h10l2 3.5a7 7 0 0 1-14 0zM7 14.5h10a3 3 0 0 1 3 3v0a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v0a3 3 0 0 1 3-3z${dot(10, 7)}${dot(14, 7)}${dot(8.5, 17.5, 1.5)}${dot(15.5, 17.5, 1.5)}`,
  gbt: `${ring(12, 12, 9)}${dot(8, 10, 1.6)}${dot(16, 10, 1.6)}${dot(12, 8)}${dot(9.5, 15)}${dot(14.5, 15)}`,
  chademo: `${ring(12, 12, 9)}${dot(8.5, 12, 2)}${dot(15.5, 12, 2)}${dot(12, 7.5)}${dot(12, 16.5)}${dot(9, 8.5, 0.9)}${dot(15, 8.5, 0.9)}`,
} as const;

export type IconName = keyof typeof paths;

const { name, size = 20, label } = Astro.props;
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  data-icon={name}><path d={paths[name]}></path></svg
>

<style>
  .icon {
    flex: none;
  }
</style>
