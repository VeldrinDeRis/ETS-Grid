---
// Смуга 1 картки товару (SPEC-003 §3.1, §3.5): галерея, заголовок, ціна з перемикачем, «Головне» і повна таблиця
// характеристик. ≥ 960 px: ліворуч галерея → «Головне» → характеристики, праворуч блок покупки прилипає.
import productContent from '../../data/product-content.json';
import { formatPrice } from '../../lib/format';
import { productImage } from '../../lib/images';
import { fullRows, hasToggle, installPrice, keyRows } from '../../lib/product';
import { routes } from '../../lib/routes';
import type { LevelKey, Product } from '../../lib/schema';
import DemoBadge from '../ui/DemoBadge.astro';
import { LEVEL_ICON } from '../../lib/level-icons';
import { ILLUSTRATION_LABEL, PHOTOS, photoSrc, productFrames } from '../../lib/photos';
import ProductGallery from '../../islands/react/ProductGallery';
import Photo from '../ui/Photo.astro';
import Icon from '../layout/Icon.astro';
import type { IconName } from '../../lib/icons';
import Placeholder from '../ui/Placeholder.astro';
import Price from '../ui/Price.astro';

interface Props {
  product: Product;
  levelKey: string;
}
const { product, levelKey } = Astro.props;
const image = productImage(product);
const SLOTS = 4;
const toggle = hasToggle(product);
const install = installPrice(product);
const compositionKey = product.type === 'kit' ? 'kit' : levelKey;
/** Набір кадрів картки (SPEC-002 §3.10) до фото від замовника: фото замовника (Q-6) замінює набір цілком. */
const frames = image ? [] : productFrames(product.slug);
const zoomSrc = (key: (typeof frames)[number]) => photoSrc(key, PHOTOS[key].widths[PHOTOS[key].widths.length - 1], 'webp');
const GALLERY_SIZES = '(max-width: 959px) calc(100vw - 2rem), 40vw';
const composition = (productContent.composition as Record<string, string[]>)[compositionKey] ?? [];
const inStock = product.stock === 'in_stock';
const isPlaceholder = (v: string) => /\[[^\]]+\]/.test(v);

/** Значок характеристики (DESIGN.md → Іконки); без відповідника — рядок без значка. */
const CONNECTOR_ICON: Record<string, IconName> = { type2: 'type2', ccs2: 'ccs2', gbt_ac: 'gbt', gbt_dc: 'gbt', chademo: 'chademo' };
const ROW_ICON: Record<string, IconName> = {
  power_kw: 'power', pcs_kw: 'power', panel_w: 'power', kwp: 'sun',
  phases: 'phases', ip: 'ip', cable: 'cable', control: 'control', capacity_kwh: 'battery', max_expand_kwh: 'battery', places: 'carport',
};
const firstConnector = Array.isArray(product.attrs.connectors) ? String(product.attrs.connectors[0]) : '';
function rowIcon(row: { key?: string; label: string }): IconName | undefined {
  if (row.key === 'connectors') return CONNECTOR_ICON[firstConnector];
  if (row.label === 'Гарантія') return 'warranty';
  return row.key ? ROW_ICON[row.key] : undefined;
}
---
<div class="ptop">
  <div class="ptop__gallery" data-product-block="gallery">
    {
      frames.length ? (
        <ProductGallery client:intent count={frames.length} label={product.name}>
          {frames.map((key, i) => (
            <div slot={`shot${i}`} class="gallery__frame">
              <Photo photo={key} sizes={GALLERY_SIZES} priority={i === 0} />
              <span class="photo-note">{ILLUSTRATION_LABEL}</span>
              <button type="button" class="gallery__zoom-btn" data-zoom={zoomSrc(key)} data-zoom-alt={PHOTOS[key].alt}>
                <Icon name="search" size={18} />
                <span class="visually-hidden">Збільшити фото</span>
              </button>
            </div>
          ))}
          {frames.map((key, i) => (
            <span slot={`thumb${i}`} class="gallery__thumb">
              <Photo photo={key} sizes="5rem" />
            </span>
          ))}
        </ProductGallery>
      ) : (
        <ul role="list" class="gallery">
          {Array.from({ length: SLOTS }, (_, i) =>
            i === 0 && image ? (
              <li class="gallery__item gallery__item--main">
                <button type="button" class="gallery__zoom" data-zoom={image.src} data-zoom-alt={image.alt}>
                  <img src={image.src} alt={image.alt} width="600" height="600" />
                  <span class="visually-hidden">Збільшити фото</span>
                </button>
              </li>
            ) : (
              <li class:list={['gallery__item', { 'gallery__item--main': i === 0 }]} data-gallery-placeholder>
                <span class="gallery__empty">
                  <Icon name={LEVEL_ICON[levelKey as LevelKey]} size={i === 0 ? 40 : 22} />
                  <Placeholder label={`[ФОТО ${i + 1}]`} />
                </span>
              </li>
            ),
          )}
        </ul>
      )
    }
    <dialog class="zoom" data-zoom-dialog aria-label="Фото товару">
      <div class="zoom__frame" data-zoom-frame></div>
      <button type="button" class="zoom__close" data-zoom-close>Закрити</button>
    </dialog>
  </div>

  <div class="ptop__info">
    <div data-product-block="header" class="pheader">
      <h1>{product.name}</h1>
      <ul role="list" class="pheader__meta">
        <li>Артикул: <Placeholder label="[АРТИКУЛ]" /></li>
        <li>Бренд: {isPlaceholder(product.brand) ? <Placeholder label={product.brand} /> : product.brand}</li>
        <li class:list={['pheader__stock', inStock ? 'is-in-stock' : 'is-preorder']}>
          <span class="pheader__led" aria-hidden="true"></span>
          {inStock ? 'В наявності' : 'Під замовлення'}
        </li>
        <li>Доставка: ≈ {product.delivery_days} дн.</li>
      </ul>
    </div>

    <div data-product-block="price" class="pprice" data-price-block data-turnkey={toggle ? 'true' : undefined}>
      {
        toggle ? (
          <>
            <fieldset class="pprice__toggle js-only" data-turnkey-toggle>
              <legend class="visually-hidden">Варіант покупки</legend>
              <label class="pprice__opt">
                <input type="radio" name="turnkey" value="false" />
                <span>Тільки обладнання</span>
              </label>
              <label class="pprice__opt">
                <input type="radio" name="turnkey" value="true" checked />
                <span>З монтажем під ключ</span>
              </label>
            </fieldset>
            <div class="pprice__value num" aria-live="polite" data-price-live>
              <p class="pprice__main" data-price-for="true">
                {formatPrice(product.price_turnkey_from)} <span class="pprice__note">з монтажем під ключ</span>
              </p>
              <p class="pprice__main" data-price-for="false">
                {formatPrice(product.price_equipment)} <span class="pprice__note">тільки обладнання</span>
              </p>
              <p class="pprice__install" data-price-for="true">монтаж від {formatPrice(install)}</p>
              {product.demo && <DemoBadge />}
            </div>
          </>
        ) : (
          <Price product={product} />
        )
      }

      <div class="pprice__includes">
        <p class="pprice__label">Що входить</p>
        <ul class="pprice__list" data-includes-for="true">
          {composition.map((c) => <li>{c.split(/(\[[^\]]+\])/).map((ch) => (isPlaceholder(ch) ? <Placeholder label={ch} /> : ch))}</li>)}
        </ul>
        {
          toggle && (
            <ul class="pprice__list" data-includes-for="false">
              {productContent.equipment_only.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="pprice__actions">
        {
          product.sale_mode === 'cart' ? (
            <button
              type="button"
              class="btn btn--primary btn--l pprice__cta js-only"
              data-add-to-cart={product.slug}
              data-turnkey={toggle ? 'true' : 'false'}
              data-source="product"
              data-main-cta
            >
              До кошика
            </button>
          ) : (
            <a class="btn btn--primary btn--l pprice__cta" href={routes.quoteFor(product.slug)} data-main-cta>
              Розрахувати
            </a>
          )
        }
        <button type="button" class="pprice__compare js-only" data-compare={product.slug} aria-pressed="false">
          Порівняти
        </button>
      </div>
      <p class="pprice__added" data-cart-added={product.slug} hidden>
        Додано до кошика · <a href={routes.cart}>Перейти до кошика</a>
      </p>
      <p class="visually-hidden" role="status" data-card-status></p>
    </div>
  </div>

  <div class="ptop__main">
    <div data-product-block="chars" class="pchars">
      <h2 class="pchars__title">Головне</h2>
      <dl class="pchars__list">
        {
          keyRows(product).map((row) => (
            <div>
              <dt>
                {rowIcon(row) && <Icon name={rowIcon(row)!} size={18} />}
                {row.label}
              </dt>
              <dd>{row.value === null ? <Placeholder label="[ДАНІ]" /> : isPlaceholder(row.value) ? <Placeholder label={row.value} /> : row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <section class="pspec" aria-labelledby="spec-title" data-product-part="spec-table">
      <h2 id="spec-title" class="pchars__title">Характеристики</h2>
      <table class="pspec__table">
        <tbody>
          {
            fullRows(product).map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.value === null ? <Placeholder label="[ДАНІ]" /> : isPlaceholder(row.value) ? <Placeholder label={row.value} /> : row.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </div>
</div>

<style>
  /* Смуга 1 (§3.5): ліворуч галерея → «Головне» → характеристики, праворуч блок покупки прилипає. */
  .ptop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'gallery info'
      'main info';
    gap: var(--space-xl);
    align-items: start;
  }
  .ptop__gallery {
    grid-area: gallery;
    min-width: 0;
  }
  .ptop__info {
    grid-area: info;
    position: sticky;
    top: var(--space-m);
  }
  .ptop__main {
    grid-area: main;
    display: grid;
    gap: var(--space-l);
    min-width: 0;
  }
  /* ---------- галерея: набір кадрів на Carousel (ProductGallery) ---------- */
  .ptop__gallery :global(astro-island) {
    display: block;
  }
  .ptop__gallery :global(.pgallery__track) {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--day-bg);
  }
  .ptop__gallery :global(.pgallery__shot) {
    width: 100%;
    flex: none;
  }
  .ptop__gallery :global(.pgallery__shot > astro-slot),
  .ptop__gallery :global(.pgallery__shot > div) {
    display: block;
    height: 100%;
  }
  .gallery__frame {
    position: relative;
    display: block;
    aspect-ratio: 1;
  }
  .gallery__frame :global(.photo),
  .gallery__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__zoom-btn {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    border-radius: 50%;
    background: rgb(244 246 248 / 0.9);
    color: var(--day-ink);
    cursor: zoom-in;
  }
  /* Без JS острів не гідратується: кадри — стрічкою з прокруткою, мініатюри ведуть до них не потрібні. */
  :global(html:not(.js)) .ptop__gallery :global(.pgallery__track ul) {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .ptop__gallery :global(.pgallery__nav) {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-s);
  }
  .ptop__gallery :global(.pgallery__arrow) {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
  }
  .ptop__gallery :global(.pgallery__arrow:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  .ptop__gallery :global(.pgallery__arrow--next) {
    grid-column: 3;
  }
  .ptop__gallery :global(.pgallery__thumbs) {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }
  .ptop__gallery :global(.pgallery__thumb) {
    position: relative;
    display: block;
    flex: none;
    width: 4.5rem;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--day-bg);
    cursor: pointer;
    opacity: 0.7;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  /* Активний кадр — мініатюра в рамці ink і з вогником (The Lit Chip Rule). */
  .ptop__gallery :global(.pgallery__thumb[aria-current='true']) {
    border-color: var(--color-ink);
    opacity: 1;
  }
  .ptop__gallery :global(.pgallery__thumb::after) {
    content: '';
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .ptop__gallery :global(.pgallery__thumb[aria-current='true']::after) {
    opacity: 1;
  }
  .gallery__thumb,
  .gallery__thumb :global(.photo),
  .gallery__thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* ---------- повна таблиця характеристик: дві колонки на desktop ---------- */
  .pspec__table {
    width: 100%;
    border-collapse: collapse;
  }
  .pspec__table tbody {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-l);
  }
  .pspec__table tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xs);
    padding: var(--space-2xs) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .pspec__table th {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
    font-weight: 400;
    text-align: left;
  }
  .pspec__table td {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xs);
  }
  .gallery__item {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--day-bg);
    color: var(--day-ink);
    overflow: hidden;
  }
  /* Місце без фото — видима рамка (D-031), щоб пробіл було видно на будь-якому фоні. */
  .gallery__item[data-gallery-placeholder] {
    border: 1px dashed var(--color-placeholder);
  }
  .gallery__item--illustration {
    position: relative;
  }
  .gallery__empty {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    color: var(--day-ink-muted);
  }
  .gallery__item--main {
    grid-column: 1 / -1;
  }
  .gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery__zoom img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .zoom {
    max-width: min(90vw, 64rem);
    padding: var(--space-m);
    border: 0;
    border-radius: var(--radius-l);
    background: var(--day-surface);
  }
  .zoom::backdrop {
    /* Ночь палітри А (#0D1424) з прозорістю; ::backdrop не всюди успадковує змінні, тому літерал. */
    background: rgb(13 20 36 / 0.75);
  }
  .zoom :global(img) {
    max-height: 80vh;
    margin-inline: auto;
  }
  .zoom__close {
    display: block;
    min-height: var(--tap);
    margin: var(--space-s) auto 0;
    padding: 0 var(--space-m);
    border: 2px solid var(--day-ink);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--day-ink);
    font-weight: 600;
    cursor: pointer;
  }
  .ptop__info {
    display: grid;
    gap: var(--space-l);
  }
  .pheader h1 {
    font-size: var(--step-3);
    margin-bottom: var(--space-xs);
  }
  .pheader__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
  .pheader__stock {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .pheader__led {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: currentColor;
  }
  .is-in-stock {
    color: var(--color-status-ok);
  }
  .is-preorder {
    color: var(--color-status-wait);
  }
  .pprice {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }
  .pprice__toggle {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .pprice__opt {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    padding: 0 var(--space-s);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-m);
    cursor: pointer;
  }
  .pprice__opt:has(input:checked) {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
    font-weight: 600;
  }
  .pprice__opt:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .pprice__value p,
  .pprice__includes p {
    margin: 0;
  }
  .pprice__main {
    font-size: var(--step-2);
    font-weight: 700;
  }
  .pprice__note,
  .pprice__install,
  .pprice__label {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
    font-weight: 400;
  }
  .pprice__list {
    margin: var(--space-3xs) 0 0;
    padding-left: 1.2em;
  }
  /* Без JS видно обидві ціни і обидва склади; з JS — лише обраний варіант. */
  :global(html.js) [data-price-block][data-turnkey='true'] [data-price-for='false'],
  :global(html.js) [data-price-block][data-turnkey='false'] [data-price-for='true'],
  :global(html.js) [data-price-block][data-turnkey='true'] [data-includes-for='false'],
  :global(html.js) [data-price-block][data-turnkey='false'] [data-includes-for='true'] {
    display: none;
  }
  .pprice__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .pprice__cta {
    flex: 1;
  }
  .pprice__compare {
    min-height: 3.25rem;
    padding: 0 var(--space-m);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .pprice__compare[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .pprice__added {
    margin: 0;
    color: var(--color-status-ok);
  }
  .pprice__added[hidden] {
    display: none;
  }
  .pchars__title {
    font-size: var(--step-1);
  }
  .pchars__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
    margin: 0;
  }
  .pchars__list dt {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
  .pchars__list dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 959.98px) {
    .ptop {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'gallery'
        'info'
        'main';
      gap: var(--space-l);
    }
    .ptop__info {
      position: static;
    }
    .ptop__gallery :global(.pgallery__track) {
      aspect-ratio: 4 / 3;
    }
    .gallery__frame {
      aspect-ratio: 4 / 3;
    }
    .ptop__gallery :global(.pgallery__thumbs) {
      justify-content: flex-start;
    }
    .ptop__gallery :global(.pgallery__thumb) {
      width: 3.5rem;
    }
    .pspec__table tbody {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Телефон: головне фото 4:3 і рядок малих мініатюр — ціна й кнопка ближче до першого екрана. */
    .gallery {
      grid-template-columns: repeat(auto-fill, 4.5rem);
    }
    .gallery__item--main {
      aspect-ratio: 4 / 3;
    }
    .gallery__item:not(.gallery__item--main) :global(.placeholder) {
      font-size: 0.7rem;
    }
