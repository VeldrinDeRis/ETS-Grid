---
// Кнопка або посилання. primary — єдина акцентна на екрані (ТЗ §8.1). Стилі — src/styles/buttons.css.
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'm' | 'l';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}
const { variant = 'primary', size = 'm', href, type = 'button', class: extra, ...rest } = Astro.props;
const className = ['btn', `btn--${variant}`, `btn--${size}`, extra].filter(Boolean).join(' ');
---
{
  href ? (
    <a href={href} class={className} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={className} {...rest}>
      <slot />
    </button>
  )
}

