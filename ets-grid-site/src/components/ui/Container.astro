---
// Ширина контенту і бокові поля.
interface Props {
  width?: 'default' | 'narrow';
  class?: string;
}
const { width = 'default', class: extra } = Astro.props;
---
<div class:list={['container', `container--${width}`, extra]}><slot /></div>

<style>
  .container {
    width: 100%;
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .container--narrow {
    max-width: calc(48rem + 2 * var(--gutter));
  }
</style>
