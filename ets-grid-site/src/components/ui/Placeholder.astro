---
// Видима мітка даних, які ще надасть замовник: [ТЕЛЕФОН], [N обʼєктів] (D-005).
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<span class="placeholder" title="Дані надасть замовник">{label}</span>

<style>
  .placeholder {
    display: inline-block;
    padding: 0 0.35em;
    border: 1px dashed currentColor;
    border-radius: var(--radius-s);
    color: var(--color-placeholder);
    font-size: 0.92em;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
</style>
