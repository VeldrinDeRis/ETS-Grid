---
// Блок ціни за правилами SPEC-001 §3.5. Кнопки сюди не входять.
import { priceView, type PriceInput } from '../../lib/price';
import DemoBadge from './DemoBadge.astro';

interface Props {
  product: PriceInput;
}
const view = priceView(Astro.props.product);
// «під ключ від 185 000 ₴» — підпис окремим рядком, сума не розривається (DESIGN.md → Components / ціна).
const LEAD = 'під ключ від ';
const lead = view.primary.startsWith(LEAD) ? LEAD : null;
const amount = lead ? view.primary.slice(LEAD.length) : view.primary;
---
<div class="price" data-on-request={view.onRequest ? '' : undefined}>
  {lead && <p class="price__lead">{lead}</p>}
  <p class="price__primary num">
    <span class="price__amount">{amount}</span>
    {view.demo && <DemoBadge />}
  </p>
  {view.secondary && <p class="price__secondary num">{view.secondary}</p>}
</div>

<style>
  .price p {
    margin: 0;
  }
  .price__primary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--step-1);
    font-weight: 700;
  }
  [data-on-request] .price__primary {
    font-size: var(--step-0);
    font-weight: 600;
  }
  .price__lead {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
  .price__amount {
    white-space: nowrap;
  }
  .price__secondary {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
</style>
