---
// Блок ціни за правилами SPEC-001 §3.5. Кнопки сюди не входять.
import { priceView, type PriceInput } from '../../lib/price';
import DemoBadge from './DemoBadge.astro';

interface Props {
  product: PriceInput;
}
const view = priceView(Astro.props.product);
---
<div class="price" data-on-request={view.onRequest ? '' : undefined}>
  <p class="price__primary num">
    {view.primary}
    {view.demo && <DemoBadge />}
  </p>
  {view.secondary && <p class="price__secondary num">{view.secondary}</p>}
</div>

<style>
  .price p {
    margin: 0;
  }
  .price__primary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--step-1);
    font-weight: 700;
  }
  [data-on-request] .price__primary {
    font-size: var(--step-0);
    font-weight: 600;
  }
  .price__secondary {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
</style>
