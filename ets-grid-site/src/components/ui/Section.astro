---
// Секція з вертикальним ритмом і поверхнею day/night (ТЗ §8.1).
import Container from './Container.astro';

interface Props {
  surface?: 'day' | 'night';
  width?: 'default' | 'narrow';
  id?: string;
  label?: string;
}
const { surface = 'day', width = 'default', id, label } = Astro.props;
---
<section class="section" data-surface={surface} id={id} aria-label={label}>
  <Container width={width}><slot /></Container>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }
</style>
