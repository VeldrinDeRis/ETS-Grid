---
// Загальна розкладка сторінки (SPEC-001 §3.3).
// crumbs — ланцюжок після «Головна»; «Головна» додається тут. На головній crumbs = [].
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/buttons.css';
import Breadcrumbs, { type Crumb } from '../components/layout/Breadcrumbs.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import { structure } from '../lib/catalog';
import { routes } from '../lib/routes';
import { breadcrumbList, fitDescription, fitTitle, organization } from '../lib/seo';
import { KEYS, PALETTE_B_FONTS } from '../lib/storage';

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  canonical?: string;
  robots?: string;
  jsonLd?: object[];
  /** title для пошуку за шаблоном SPEC-008 §3.1; без нього — «{title} · ETS GRID». */
  metaTitle?: string;
  /** Open Graph: product для товарів (SPEC-008 §3.3). */
  ogType?: 'website' | 'product' | 'article';
  /** Абсолютний або кореневий шлях до картинки; без неї og:image не виводиться. */
  ogImage?: string;
  surface?: 'day' | 'night';
}

const { title, description, crumbs = [], canonical, robots = 'index, follow', jsonLd = [], surface = 'day', metaTitle, ogType = 'website', ogImage } = Astro.props;

const isHome = Astro.url.pathname === routes.home;
const fullTitle = fitTitle(metaTitle ?? title, isHome);
const metaDescription = fitDescription(description);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const trail: Crumb[] = crumbs.length > 0 ? [{ label: 'Головна', href: routes.home }, ...crumbs] : [];
const indexable = !robots.startsWith('noindex');
// Organization — на всіх сторінках, BreadcrumbList — нижче головної (SPEC-008 §3.2).
const schema = [
  organization(Astro.site!, structure.contacts),
  ...(trail.length > 0 ? [breadcrumbList(Astro.site!, trail, Astro.url.pathname)] : []),
  ...jsonLd,
];
const paletteKey = KEYS.palette;
const paletteBFonts = PALETTE_B_FONTS;
---
<!doctype html>
<html lang="uk" data-palette="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    {
      indexable && (
        <>
          <link rel="alternate" hreflang="uk" href={canonicalUrl} />
          <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
        </>
      )
    }
    <meta property="og:site_name" content="ETS GRID" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Шрифти напряму А — свої, 2 файли-сабсети (SPEC-010, D-039). -->
    <link rel="preload" href="/fonts/geologica.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/wix-madefor-text.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ paletteKey, paletteBFonts }}>
      document.documentElement.classList.add('js');
      // Рух дозволено — CSS заздалегідь приглушує H1 героя, щоб не було спалаху до splitText (SPEC-006 §4.8).
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.dataset.motion = 'on';
      try {
        var saved = JSON.parse(localStorage.getItem(paletteKey));
        if (saved === 'a' || saved === 'b') document.documentElement.dataset.palette = saved;
        // Запасний напрям Б — шрифти з Google Fonts лише тоді, коли його увімкнули.
        if (saved === 'b') {
          var l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = paletteBFonts;
          l.dataset.paletteFonts = 'b';
          document.head.appendChild(l);
        }
      } catch (e) {}
    </script>
    {schema.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <SkipLink />
    <Header />
    <div class="page" data-surface={surface}>
      {trail.length > 0 && <Breadcrumbs items={trail} />}
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />
    <script>
      import '../scripts/utm';
    </script>
  </body>
</html>

<style>
  .page {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  main:focus {
    outline: none;
  }
</style>
