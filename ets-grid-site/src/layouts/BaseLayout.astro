---
// Загальна розкладка сторінки (SPEC-001 §3.3).
// crumbs — ланцюжок після «Головна»; «Головна» додається тут. На головній crumbs = [].
import '../styles/tokens.css';
import '../styles/base.css';
import Breadcrumbs, { type Crumb } from '../components/layout/Breadcrumbs.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import { routes } from '../lib/routes';
import { KEYS } from '../lib/storage';

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  canonical?: string;
  robots?: string;
  jsonLd?: object[];
  surface?: 'day' | 'night';
}

const { title, description, crumbs = [], canonical, robots = 'index, follow', jsonLd = [], surface = 'day' } = Astro.props;

const isHome = Astro.url.pathname === routes.home;
const fullTitle = isHome ? title : `${title} · ETS GRID`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const trail: Crumb[] = crumbs.length > 0 ? [{ label: 'Головна', href: routes.home }, ...crumbs] : [];
const paletteKey = KEYS.palette;
---
<!doctype html>
<html lang="uk" data-palette="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ paletteKey }}>
      document.documentElement.classList.add('js');
      try {
        var saved = JSON.parse(localStorage.getItem(paletteKey));
        if (saved === 'a' || saved === 'b') document.documentElement.dataset.palette = saved;
      } catch (e) {}
    </script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <SkipLink />
    <Header />
    <div class="page" data-surface={surface}>
      {trail.length > 0 && <Breadcrumbs items={trail} />}
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>

<style>
  .page {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  main:focus {
    outline: none;
  }
</style>
