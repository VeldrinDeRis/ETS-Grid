---
// Сторінка-заглушка: розкладка + H1 + плашка «Сторінка в роботі» (SPEC-001 §3.1).
import type { Crumb } from '../components/layout/Breadcrumbs.astro';
import StubNotice from '../components/layout/StubNotice.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  spec: string;
  note?: string;
  crumbs?: Crumb[];
  robots?: string;
}
const { title, description, spec, note, crumbs = [{ label: title }], robots } = Astro.props;
---
<BaseLayout title={title} description={description} crumbs={crumbs} robots={robots}>
  <Section>
    <h1>{title}</h1>
    <slot name="lead" />
    <StubNotice spec={spec} note={note} />
    <slot />
  </Section>
</BaseLayout>
