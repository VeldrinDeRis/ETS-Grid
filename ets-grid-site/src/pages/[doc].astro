---
// Документи (оферта, політики, гарантія) — тексти надає замовник (ТЗ §11); шаблон — SPEC-007.
import type { GetStaticPaths } from 'astro';
import StubPage from '../layouts/StubPage.astro';
import { structure } from '../lib/catalog';

export const getStaticPaths = (() =>
  structure.documents.map((doc) => ({ params: { doc: doc.slug }, props: { doc } }))) satisfies GetStaticPaths;

interface Props {
  doc: { slug: string; name: string };
}
const { doc } = Astro.props;
---
<StubPage title={doc.name} description={`${doc.name} ETS GRID.`} spec="SPEC-007" note="Текст документа надає замовник." />
