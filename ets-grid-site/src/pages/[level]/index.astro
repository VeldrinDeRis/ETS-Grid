---
// Сторінка рівня — заглушка; наповнює SPEC-002. Solar Carport має власну сторінку (SPEC-004).
import type { GetStaticPaths } from 'astro';
import StubNotice from '../../components/layout/StubNotice.astro';
import Section from '../../components/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getLevels } from '../../lib/catalog';
import { routes } from '../../lib/routes';
import type { StructureLevel } from '../../lib/schema';

export const getStaticPaths = (() =>
  getLevels()
    .filter((level) => level.key !== 'carport')
    .map((level) => ({ params: { level: level.slug }, props: { level } }))) satisfies GetStaticPaths;

interface Props {
  level: StructureLevel;
}
const { level } = Astro.props;
const categories = getCategories(level.key);
---
<BaseLayout title={level.name} description={`${level.name}: ${level.short}. Підбір, доставка й монтаж.`} crumbs={[{ label: level.name }]}>
  <Section>
    <h1>{level.name}</h1>
    <p>{level.short}</p>
    <StubNotice spec="SPEC-002" note="Тут будуть міні-герой рівня, підбірник, каталог з фільтрами, «Як обрати» і FAQ (ТЗ §6.2)." />
    <ul role="list" class="categories">
      {
        categories.map((c) => (
          <li>
            <a href={routes.category(level.slug, c.slug)}>{c.name}</a>
            {c.hint && <span>{c.hint}</span>}
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  .categories {
    display: grid;
    gap: var(--space-2xs);
  }
  .categories li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
  }
  .categories a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
  .categories span {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
</style>
