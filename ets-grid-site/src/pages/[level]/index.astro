---
// Сторінка рівня (SPEC-002 §3.4, ТЗ §6.2). Solar Carport — окрема сторінка (SPEC-004).
import type { GetStaticPaths } from 'astro';
import levelContentJson from '../../data/level-content.json';
import Catalog from '../../components/catalog/Catalog.astro';
import CategoryTiles from '../../components/catalog/CategoryTiles.astro';
import LevelGuide from '../../components/catalog/LevelGuide.astro';
import LevelHero from '../../components/catalog/LevelHero.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import Picker from '../../components/pickers/Picker.astro';
import Section from '../../components/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getLevels, getProductsBy } from '../../lib/catalog';
import type { LevelContent } from '../../lib/level-content';
import type { StructureLevel } from '../../lib/schema';

export const getStaticPaths = (() =>
  getLevels()
    .filter((level) => level.key !== 'carport')
    .map((level) => ({ params: { level: level.slug }, props: { level } }))) satisfies GetStaticPaths;

interface Props {
  level: StructureLevel;
}
const { level } = Astro.props;
const text = (levelContentJson as LevelContent)[level.key as keyof LevelContent];
const categories = getCategories(level.key);
const products = await getProductsBy({ level: level.key });
---
<BaseLayout title={level.name} description={`${level.name}: ${text.value}`} crumbs={[{ label: level.name }]}>
  <Section>
    <div data-level-block="hero">
      <LevelHero title={level.name} value={text.value} pickerHref="#pidbir" />
    </div>
  </Section>

  <Section label="Розділи">
    <div data-level-block="tiles">
      <h2>Розділи</h2>
      <CategoryTiles levelSlug={level.slug} categories={categories} products={products} />
    </div>
  </Section>

  <Section id="pidbir" label="Підбір за 3 питання" surface="night">
    <div data-level-block="picker">
      <h2>Підбір за 3 питання</h2>
      <Picker kind={level.key as 'charging' | 'solar' | 'battery'} />
    </div>
  </Section>

  <Section label="Каталог">
    <div data-level-block="catalog">
      <h2>Каталог: {level.name.toLowerCase()}</h2>
      <Catalog products={products} levelId={level.id} />
    </div>
  </Section>

  <Section>
    <div data-level-block="guide">
      <LevelGuide part="guide" text={text} levelName={level.name} />
    </div>
  </Section>

  <Section>
    <div data-level-block="cross">
      <LevelGuide part="cross" text={text} levelName={level.name} />
    </div>
  </Section>

  <Section>
    <div data-level-block="faq">
      <LevelGuide part="faq" text={text} levelName={level.name} />
    </div>
    <div data-level-block="form">
      <LeadForm kind="level" level={level.key} />
    </div>
  </Section>
</BaseLayout>
