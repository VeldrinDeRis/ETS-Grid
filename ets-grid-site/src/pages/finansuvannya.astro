---
// Фінансування (SPEC-007 §3.1): програми з плейсхолдерами, дата перевірки, навігатор «Чи підходите».
// Без JS — питання сховані, видно весь список програм; з JS — src/scripts/financing.ts фільтрує список.
import Text from '../components/content/Text.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../lib/content';
import { routes } from '../lib/routes';
import '../styles/content.css';

const f = content.financing;
---
<BaseLayout
  title="Фінансування"
  description="Кредит на СЕС і накопичувачі, компенсації для дому, гранти для бізнесу, покупка частинами. Умови з датою перевірки."
  crumbs={[{ label: 'Фінансування' }]}
>
  <Section>
    <h1>Фінансування</h1>
    <p class="cp-lead">{f.lead}</p>
    <p class="fin-checked" data-content-block="checked"><Text value={f.checked} /></p>

    <div class="fin">
      <form class="fin-nav js-only" data-financing-nav data-content-block="navigator" aria-labelledby="fin-nav-title">
        <h2 id="fin-nav-title">Чи підходите?</h2>
        {
          f.questions.map((q) => (
            <fieldset class="fin-q">
              <legend>{q.legend}</legend>
              <div class="fin-q__options">
                {q.options.map(([value, label]) => (
                  <label class="fin-option">
                    <input type="radio" name={q.key} value={value} />
                    <span>
                      <Text value={label} />
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
        <button type="reset" class="fin-reset">Скинути відповіді</button>
      </form>

      <section class="fin-programs" aria-labelledby="fin-programs-title" data-content-block="programs">
        <h2 id="fin-programs-title">Програми</h2>
        <p class="fin-count js-only" role="status" data-financing-count></p>
        <ul role="list" class="cp-cards fin-list">
          {
            f.programs.map((p) => (
              <li class="cp-card" data-program={p.id} data-who={p.who.join(' ')} data-what={p.what.join(' ')} data-sum={p.sum.join(' ')}>
                <h3>
                  <Text value={p.title} />
                </h3>
                <p>
                  <Text value={p.text} />
                </p>
              </li>
            ))
          }
        </ul>
        <p class="fin-none" data-financing-none hidden>{f.none}</p>
        <div class="cp-actions">
          <a class="cp-cta" href={routes.quote}>{f.cta}</a>
        </div>
      </section>
    </div>
  </Section>
</BaseLayout>

<script>
  import '../scripts/financing';
</script>

<style>
  .fin-checked {
    margin: 0 0 var(--space-l);
  }
  .fin {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 960px) {
    .fin {
      grid-template-columns: 22rem minmax(0, 1fr);
      align-items: start;
    }
  }
  .fin-nav {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }
  .fin-nav h2,
  .fin-programs h2 {
    margin: 0;
    font-size: var(--step-1);
  }
  .fin-q {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .fin-q legend {
    padding: 0;
    margin-bottom: var(--space-2xs);
    font-weight: 600;
  }
  .fin-q__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .fin-option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    padding: 0 var(--space-s);
    border: 1px solid var(--color-ink-muted);
    border-radius: var(--radius-m);
    cursor: pointer;
  }
  .fin-option:has(input:checked) {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .fin-option:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .fin-option input {
    accent-color: var(--color-ink);
  }
  .fin-reset {
    justify-self: start;
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    text-decoration: underline;
    cursor: pointer;
  }
  .fin-programs {
    min-width: 0;
  }
  .fin-count {
    margin: var(--space-2xs) 0 var(--space-s);
    font-weight: 600;
  }
  .fin-list {
    margin-top: var(--space-s);
    margin-bottom: var(--space-s);
  }
  .fin-list [hidden],
  .fin-none[hidden] {
    display: none;
  }
  .fin-none {
    padding: var(--space-m);
    border: 1px dashed var(--color-ink-muted);
    border-radius: var(--radius-l);
  }
</style>
