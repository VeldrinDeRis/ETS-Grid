---
// Головна — заглушка; наповнює SPEC-006 після раунду дизайну.
import StubNotice from '../components/layout/StubNotice.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import Picker from '../components/pickers/Picker.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLevels } from '../lib/catalog';
import { routes } from '../lib/routes';

const levels = getLevels();
---
<BaseLayout
  title="ETS GRID — зарядні станції та сонячна енергія під ключ"
  description="Зарядні станції, сонячні панелі, батареї та Solar Carport з підбором, доставкою й монтажем. Київ і вся Україна."
>
  <Section>
    <h1>Зарядні станції та сонячна енергія під ключ</h1>
    <StubNotice spec="SPEC-006" note="Тут буде продаючий перший екран і 11 блоків головної з ТЗ §6.1." />
    <ul role="list" class="levels">
      {
        levels.map((level) => (
          <li>
            <a href={routes.level(level.slug)}>
              <strong>{level.name}</strong>
              <span>{level.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="potuzhnist" label="Чи вистачить потужності?" surface="night">
    <!-- SPEC-004 §3.3: тимчасово на заглушці; SPEC-006 переставить у блок 3 головної (D-029 п. 6). -->
    <h2>Чи вистачить потужності?</h2>
    <Picker kind="power" />
  </Section>

  <Section id="zayavka" label="Заявка">
    <!-- SPEC-009 ревізія 1: тимчасово на заглушці; реалізація SPEC-006 поставить форму в блок 11. -->
    <LeadForm kind="final" />
  </Section>
</BaseLayout>

<style>
  .levels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-s);
  }
  .levels a {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    height: 100%;
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    text-decoration: none;
  }
  .levels span {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
</style>
