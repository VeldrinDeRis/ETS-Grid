---
// Головна (SPEC-006, етап 1): 11 блоків ТЗ §6.1 у фіксованому порядку.
import EnergyFlow from '../components/home/EnergyFlow.astro';
import HomeBlocks from '../components/home/HomeBlocks.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeHits from '../components/home/HomeHits.astro';
import HomeSystems from '../components/home/HomeSystems.astro';
import Picker from '../components/pickers/Picker.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { activeVariant } from '../lib/home';

const variant = activeVariant();
---
<BaseLayout
  title={`ETS GRID — ${variant.h1}`}
  description="Зарядні станції, сонячні панелі, батареї та Solar Carport для бізнесу й дому: перевірка вводу, доставка, монтаж під ключ. Київ і вся Україна."
>
  <HomeHero />

  <Section label="Що вам потрібно?">
    <div data-home-block="systems"><HomeSystems /></div>
  </Section>

  <Section id="potuzhnist" label="Чи вистачить потужності?" surface="night">
    <div data-home-block="power">
      <h2>Чи вистачить потужності?</h2>
      <Picker kind="power" />
    </div>
  </Section>

  <Section label="Хіти каталогу">
    <div data-home-block="hits"><HomeHits /></div>
  </Section>

  <Section label="Не тільки розетка" surface="night">
    <div data-home-block="flow"><EnergyFlow /></div>
  </Section>

  <Section label="Solar Carport">
    <div data-home-block="carport"><HomeBlocks part="carport" /></div>
  </Section>

  <Section label="Як ми працюємо">
    <div data-home-block="steps"><HomeBlocks part="steps" /></div>
  </Section>

  <Section label="Незручні питання">
    <div data-home-block="faq"><HomeBlocks part="faq" /></div>
  </Section>

  <Section label="Обʼєкти">
    <div data-home-block="cases"><HomeBlocks part="cases" /></div>
  </Section>

  <Section label="Фінансування">
    <div data-home-block="financing"><HomeBlocks part="financing" /></div>
  </Section>

  <Section label="Заявка" surface="night">
    <div data-home-block="final"><HomeBlocks part="final" /></div>
  </Section>
</BaseLayout>

<script>
  import '../scripts/home';
</script>
