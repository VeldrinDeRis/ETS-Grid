---
// Головна (SPEC-006, етап 1): 11 блоків ТЗ §6.1 у фіксованому порядку.
import EnergyFlow from '../components/home/EnergyFlow.astro';
import HomeBlocks from '../components/home/HomeBlocks.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeHits from '../components/home/HomeHits.astro';
import HomeSystems from '../components/home/HomeSystems.astro';
import Picker from '../components/pickers/Picker.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { activeVariant, home } from '../lib/home';
import { faqPage, ld } from '../lib/seo';

const variant = activeVariant();
---
<BaseLayout
  title={variant.h1}
  jsonLd={ld(faqPage(home.faq))}
  description="Зарядні станції, сонячні панелі, батареї та Solar Carport для бізнесу й дому: перевірка вводу, доставка, монтаж під ключ. Київ і вся Україна."
>
  <HomeHero />

  <!-- Акт II «Система» (SPEC-006 §4.9, D-055): схема-сцена (блок 5) перед входом за сценарієм (блок 2), обидва на ночі. -->
  <Section id="systema" label="Одна система" surface="night">
    <div data-home-block="flow"><EnergyFlow /></div>
    <div data-home-block="systems" class="systems-after-flow"><HomeSystems /></div>
  </Section>

  <Section id="potuzhnist" label="Чи вистачить потужності?" surface="night">
    <div data-home-block="power">
      <h2>Чи вистачить потужності?</h2>
      <Picker kind="power" />
    </div>
  </Section>

  <!-- Акт IV «Вітрина» (SPEC-006 §4.10, D-060): день входить через «світанок»; хіти — карусель, Carport одним рядком. -->
  <Section label="Хіти каталогу" seam="dawn">
    <div data-home-block="hits"><HomeHits /></div>
  </Section>

  <Section label="Solar Carport">
    <div data-home-block="carport"><HomeBlocks part="carport" /></div>
  </Section>

  <!-- Акт V «Довіра і дія» (SPEC-006 §4.10, D-060): одна нічна секція — зліва довіра (блоки 7–10), праворуч форма (11). -->
  <Section id="zayavka" label="Заявка" surface="night" seam="dusk">
    <div class="trust-act" data-act="trust">
      <div class="trust-act__trust">
        <div data-home-block="steps"><HomeBlocks part="steps" /></div>
        <div data-home-block="faq"><HomeBlocks part="faq" /></div>
        <div data-home-block="cases"><HomeBlocks part="cases" /></div>
        <div data-home-block="financing"><HomeBlocks part="financing" /></div>
      </div>
      <div class="trust-act__form" data-home-block="final"><HomeBlocks part="final" /></div>
    </div>
  </Section>
</BaseLayout>

<script>
  import '../scripts/home';
</script>

<style>
  /* Вхід за сценарієм — під сценою схеми, тихіше за акт. */
  .systems-after-flow {
    margin-top: var(--space-2xl);
  }
  /* Акт V: довіра зліва стовпцем, форма праворуч і липне, поки гортають довіру. На телефоні — довіра, потім форма. */
  .trust-act {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-2xl) var(--space-xl);
    align-items: start;
  }
  .trust-act__trust {
    display: grid;
    gap: var(--space-2xl);
  }
  .trust-act__form {
    position: sticky;
    top: calc(var(--header-h) + 3rem + var(--space-m));
  }
  @media (max-width: 959.98px) {
    .trust-act {
      grid-template-columns: 1fr;
    }
    .trust-act__form {
      position: static;
    }
  }
</style>
