---
// Оформлення замовлення (SPEC-005 §3.3): одна сторінка, 3 кроки, без реєстрації.
import NoJsNote from '../components/shop/NoJsNote.astro';
import Section from '../components/ui/Section.astro';
import Checkout from '../islands/shop/Checkout';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../lib/routes';
import { shopProducts } from '../lib/shop-data';

const products = await shopProducts();
---
<BaseLayout
  title="Оформлення замовлення"
  description="Оформлення замовлення без реєстрації: контакти, доставка, оплата."
  crumbs={[{ label: 'Кошик', href: routes.cart }, { label: 'Оформлення' }]}
  robots="noindex, follow"
>
  <Fragment slot="top">
    <h1>Оформлення замовлення</h1>
  </Fragment>
  <Section seam="dawn">
    <NoJsNote text="Оформлення працює з увімкненим JavaScript. Або залиште заявку — менеджер оформить замовлення за вас." levels={false} />
    <p class="nojs-quote"><a href={routes.quote}>Залишити заявку</a></p>
    <Checkout client:load products={products} />
  </Section>
</BaseLayout>

<style>
  :global(html.js) .nojs-quote {
    display: none;
  }
</style>
