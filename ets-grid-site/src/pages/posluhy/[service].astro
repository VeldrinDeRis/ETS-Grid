---
import type { GetStaticPaths } from 'astro';
import StubPage from '../../layouts/StubPage.astro';
import { structure } from '../../lib/catalog';
import { routes } from '../../lib/routes';

export const getStaticPaths = (() =>
  structure.services.map((service) => ({ params: { service: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: { slug: string; name: string };
}
const { service } = Astro.props;
---
<StubPage
  title={service.name}
  description={`${service.name} від ETS GRID: що входить, строки, вартість.`}
  spec="SPEC-007"
  note="Зміст сторінки послуги — ТЗ §6.7."
  crumbs={[{ label: 'Послуги', href: routes.services }, { label: service.name }]}
/>
