---
// Послуги (SPEC-007 §3.1): 4 картки.
import Section from '../../components/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { structure } from '../../lib/catalog';
import { content } from '../../lib/content';
import { routes } from '../../lib/routes';
import '../../styles/content.css';

const pages = content.services.pages as Record<string, { short: string }>;
---
<BaseLayout title="Послуги" description="Доставка, монтаж, проєкт і техумови, сервіс і гарантія від ETS GRID." crumbs={[{ label: 'Послуги' }]}>
  <Fragment slot="top">
    <h1>Послуги</h1>
    <p class="cp-lead">{content.services.lead}</p>
  </Fragment>
  <Section seam="dawn">
    <ul role="list" class="cp-cards" data-content-block="services-list">
      {
        structure.services.map((s) => (
          <li class="cp-card">
            <h2>
              <a href={routes.service(s.slug)}>{s.name}</a>
            </h2>
            <p>{pages[s.slug].short}</p>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
