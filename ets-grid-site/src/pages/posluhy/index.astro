---
import StubPage from '../../layouts/StubPage.astro';
import { structure } from '../../lib/catalog';
import { routes } from '../../lib/routes';
---
<StubPage title="Послуги" description="Доставка, монтаж, проєкт і техумови, сервіс і гарантія від ETS GRID." spec="SPEC-007">
  <ul role="list">
    {
      structure.services.map((s) => (
        <li>
          <a href={routes.service(s.slug)}>{s.name}</a>
        </li>
      ))
    }
  </ul>
</StubPage>

<style>
  li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
</style>
