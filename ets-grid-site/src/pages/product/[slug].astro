---
// Сторінка товару (SPEC-003, ТЗ §6.4): 11 блоків у порядку ТЗ.
import type { GetStaticPaths } from 'astro';
import ProductDetails from '../../components/product/ProductDetails.astro';
import ProductTop from '../../components/product/ProductTop.astro';
import Section from '../../components/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getLevelById, getProductsBy } from '../../lib/catalog';
import { formatPrice } from '../../lib/format';
import { priceView } from '../../lib/price';
import { hasToggle } from '../../lib/product';
import { routes } from '../../lib/routes';
import levelContentJson from '../../data/level-content.json';
import { keyChars } from '../../lib/filters';
import { productImage } from '../../lib/images';
import type { LevelContent } from '../../lib/level-content';
import { faqPage, ld, productLd, seoTitle } from '../../lib/seo';
import type { Product } from '../../lib/schema';

export const getStaticPaths = (async () =>
  (await getProductsBy()).map((product) => ({ params: { slug: product.slug }, props: { product } }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}
const { product } = Astro.props;
const level = getLevelById(product.level);
const category = getCategories(level.key).find((c) => c.slug === product.category)!;
const stickyPrice = hasToggle(product) ? formatPrice(product.price_turnkey_from) : priceView(product).primary;
const view = priceView(product);
const image = productImage(product);
const chars = keyChars(product).slice(0, 2);
const faq = (levelContentJson as Partial<LevelContent>)[level.key as keyof LevelContent]?.faq ?? [];
---
<BaseLayout
  title={product.name}
  metaTitle={seoTitle.product(product.name, view.onRequest ? null : view.primary)}
  description={`${product.name}${chars.length ? `: ${chars.join(', ')}` : ''}. Ціна з монтажем під ключ, характеристики, доставка.`}
  ogType="product"
  ogImage={image?.src}
  jsonLd={ld(productLd(Astro.site!, product, image?.src ?? null), faqPage(faq))}
  crumbs={[
    { label: level.name, href: routes.level(level.slug) },
    { label: category.name, href: routes.category(level.slug, category.slug) },
    { label: product.name },
  ]}
>
  <Section seam="dawn">
    <div data-product-slug={product.slug}>
      <ProductTop product={product} levelKey={level.key} />
      <ProductDetails product={product} levelKey={level.key} levelSlug={level.slug} />
    </div>
  </Section>

  <div class="sticky" data-product-block="sticky" data-sticky hidden>
    <span class="sticky__price num" data-sticky-price>{stickyPrice}</span>
    {
      product.sale_mode === 'cart' ? (
        <button type="button" class="btn btn--primary sticky__cta" data-add-to-cart={product.slug} data-turnkey={hasToggle(product) ? 'true' : 'false'} data-source="sticky">
          До кошика
        </button>
      ) : (
        <a class="btn btn--primary sticky__cta" href={routes.quoteFor(product.slug)}>
          Розрахувати
        </a>
      )
    }
  </div>
</BaseLayout>

<script>
  import '../../scripts/product';
  import '../../scripts/card-actions';
</script>

<style>
  .sticky {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-xs) var(--gutter);
    background: var(--color-surface);
    box-shadow: 0 -4px 16px rgb(0 0 0 / 0.12);
  }
  .sticky__price {
    font-weight: 700;
    font-size: var(--step-1);
  }
  .sticky__cta {
    padding-inline: var(--space-l);
  }
  /* Липка панель — лише на mobile; з атрибутом hidden прихована, поки блок ціни у полі зору. */
  @media (max-width: 959.98px) {
    .sticky:not([hidden]) {
      display: flex;
    }
    :global(body.has-sticky) {
      padding-bottom: 4.5rem;
    }
  }
</style>
