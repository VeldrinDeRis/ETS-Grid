---
// Solar Carport — рівень-лендинг із конфігуратором; наповнює SPEC-004.
import StubNotice from '../../components/layout/StubNotice.astro';
import Section from '../../components/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getLevel } from '../../lib/catalog';
import { routes } from '../../lib/routes';

const level = getLevel('carport');
const categories = getCategories('carport');
---
<BaseLayout title={level.name} description={`${level.name}: ${level.short}. Розрахунок навісу під вашу ділянку.`} crumbs={[{ label: level.name }]}>
  <Section>
    <h1>{level.name}</h1>
    <p>{level.short}</p>
    <StubNotice spec="SPEC-004" note="Тут будуть «4 функції в одній площі», конфігуратор навісу, типові конструкції й форма «Отримати проєкт» (ТЗ §6.6)." />
    <ul role="list">
      {
        categories.map((c) => (
          <li>
            <a href={routes.category(level.slug, c.slug)}>{c.name}</a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
</style>
