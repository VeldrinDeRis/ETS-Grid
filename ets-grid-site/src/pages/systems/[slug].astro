---
import type { GetStaticPaths } from 'astro';
import ProductStubList from '../../components/layout/ProductStubList.astro';
import StubPage from '../../layouts/StubPage.astro';
import { getProduct, getSystems } from '../../lib/catalog';
import { routes } from '../../lib/routes';
import type { Product, System } from '../../lib/schema';

export const getStaticPaths = (async () =>
  (await getSystems()).map((system) => ({ params: { slug: system.slug }, props: { system } }))) satisfies GetStaticPaths;

interface Props {
  system: System;
}
const { system } = Astro.props;
const items = (await Promise.all(system.items.map((slug) => getProduct(slug)))).filter((p): p is Product => Boolean(p));
---
<StubPage
  title={system.name}
  description={`Готова система «${system.name}»: склад, результат, ціна під ключ.`}
  spec="SPEC-007"
  note="Тут будуть схема системи, склад, результат у цифрах, ціна «під ключ від», строки й фінансування (ТЗ §6.5)."
  crumbs={[{ label: 'Готові системи', href: routes.systems }, { label: system.name }]}
>
  <p slot="lead">{system.result}</p>
  <ProductStubList products={items} />
</StubPage>
